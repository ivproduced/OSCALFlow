{
  "name": "oscalflow",
  "version": "1.1.0",
  "description": "OSCALFLOW - Automated OSCAL compliance documentation for GitHub repositories",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ivproduced/OSCALFlow.git"
  },
  "homepage": "https://github.com/ivproduced/OSCALFlow",
  "bugs": {
    "url": "https://github.com/ivproduced/OSCALFlow/issues"
  },
  "bin": {
    "gh-oscal": "./bin/gh-oscal"
  },
  "scripts": {
    "build": "tsc && cp -r src/templates dist/",
    "dev": "tsx watch src/index.ts",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "github-cli-extension",
    "oscal",
    "compliance",
    "fedramp",
    "nist",
    "security",
    "automation",
    "ssp"
  ],
  "author": "euCann",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "tsx": "^4.22.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
