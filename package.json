{
  "name": "oscalflow",
  "version": "1.0.0",
  "description": "OSCALFLOW - Automated OSCAL compliance documentation for GitHub repositories",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/eucann/oscalflow.git"
  },
  "homepage": "https://github.com/eucann/oscalflow",
  "bugs": {
    "url": "https://github.com/eucann/oscalflow/issues"
  },
  "bin": {
    "gh-oscal": "./bin/gh-oscal"
  },
  "scripts": {
    "build": "tsc && cp -r src/templates dist/",
    "dev": "tsx watch src/index.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "github-cli-extension",
    "oscal",
    "compliance",
    "fedramp",
    "nist",
    "security",
    "automation",
    "ssp"
  ],
  "author": "euCann",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
