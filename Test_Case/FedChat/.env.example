# FedChat System Environment Configuration
# Copy this file to .env and configure for your environment

# =============================================================================
# AGENCY CONFIGURATION
# =============================================================================
AGENCY_NAME="Federal Agency"
AGENCY_LOGO_URL="/assets/agency-logo.png"
AGENCY_PRIMARY_COLOR="#002868"
AGENCY_SECONDARY_COLOR="#FFFFFF"

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=production
API_URL=http://backend:8000
FRONTEND_URL=http://localhost:3000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_DB=fedchat
POSTGRES_USER=fedchat_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Enable pgvector for RAG
POSTGRES_EXTENSIONS=pgvector

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# Options: local, azure, aws, custom
LLM_PROVIDER=local

# For local models (Ollama, llama.cpp, vLLM)
LOCAL_LLM_BASE_URL=http://ollama:11434
LOCAL_LLM_MODEL=llama3:70b
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# For Azure OpenAI (FedRAMP High)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-api-key
# AZURE_OPENAI_DEPLOYMENT=gpt-4
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# For AWS Bedrock (FedRAMP High)
# AWS_REGION=us-gov-west-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_BEDROCK_MODEL=anthropic.claude-3-sonnet

# =============================================================================
# RAG CONFIGURATION
# =============================================================================
ENABLE_RAG=true
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# Document storage
DOCUMENT_STORAGE_PATH=/data/documents
MAX_DOCUMENT_SIZE_MB=50
ALLOWED_DOCUMENT_TYPES=pdf,docx,txt,md,csv

# =============================================================================
# NIST STANDARDS RAG CONFIGURATION
# =============================================================================
ENABLE_NIST_RAG=true

# HuggingFace dataset configuration
NIST_USE_HUGGINGFACE=true
NIST_DATASET_NAME=ethanolivertroy/nist-cybersecurity-training

# Local cache directory (requires ~7GB for dataset + FAISS index)
NIST_RAG_CACHE_DIR=/app/.cache/nist_rag

# OpenAI embeddings for NIST RAG (required for semantic search)
# Use Azure OpenAI endpoint for FedRAMP compliance if needed
OPENAI_API_KEY=your-openai-api-key-here
NIST_EMBEDDING_MODEL=text-embedding-ada-002

# NIST RAG features
NIST_TOP_K_RESULTS=5
NIST_MIN_SIMILARITY=0.7

# =============================================================================
# POLICY RAG CONFIGURATION
# =============================================================================
ENABLE_POLICY_RAG=true

# Policy repository (GitHub URL)
POLICY_REPO_URL=https://github.com/0xdefendA/policies.git

# Local cache directory (requires ~100MB for demo policies)
POLICY_RAG_CACHE_DIR=/app/.cache/policy_rag

# Uses same OpenAI embeddings as NIST RAG
# OPENAI_API_KEY configured in NIST RAG section above
POLICY_EMBEDDING_MODEL=text-embedding-ada-002

# Policy document processing
POLICY_CHUNK_SIZE=1000
POLICY_CHUNK_OVERLAP=200

# =============================================================================
# GUARDRAILS CONFIGURATION
# =============================================================================
ENABLE_GUARDRAILS=true
GUARDRAILS_CONFIG_PATH=/app/guardrails/config.yml

# PII Detection
ENABLE_PII_DETECTION=true
PII_REDACTION_MODE=mask  # Options: mask, remove, alert

# Content Filtering
ENABLE_CONTENT_FILTER=true
BLOCKED_TOPICS=classified_info,personal_health,ssn

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=30

# =============================================================================
# MCP (Model Context Protocol) CONFIGURATION
# =============================================================================
ENABLE_MCP=true
MCP_SERVERS_CONFIG=/app/mcp-servers/config.json

# Available MCP servers (comma-separated)
ENABLED_MCP_SERVERS=filesystem,database,api-client,servicenow,splunk

# ServiceNow Configuration
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=your-username
SERVICENOW_PASSWORD=your-password

# Splunk Configuration
SPLUNK_HOST=splunk.agency.gov
SPLUNK_PORT=8089
SPLUNK_API_TOKEN=your-splunk-api-token
SPLUNK_VERIFY_SSL=true  # Set to 'false' only for dev/test environments

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Session Configuration
SESSION_SECRET=CHANGE_THIS_TO_ANOTHER_SECURE_RANDOM_STRING
SESSION_LIFETIME_HOURS=8
SESSION_REFRESH_HOURS=1

# SAML/SSO Configuration (optional)
ENABLE_SAML=false
# SAML_IDP_ENTITY_ID=https://idp.agency.gov/saml
# SAML_IDP_SSO_URL=https://idp.agency.gov/sso
# SAML_IDP_CERT_PATH=/app/config/idp-cert.pem
# SAML_SP_ENTITY_ID=https://fedchat.agency.gov
# SAML_SP_CERT_PATH=/app/config/sp-cert.pem
# SAML_SP_KEY_PATH=/app/config/sp-key.pem

# =============================================================================
# AUDIT & LOGGING
# =============================================================================
AUDIT_LOG_LEVEL=comprehensive  # Options: standard, detailed, comprehensive
AUDIT_LOG_PATH=/var/log/fedchat/audit.log
AUDIT_RETENTION_DAYS=2555  # 7 years for FISMA compliance

# Application Logging
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # Options: json, text

# =============================================================================
# MONITORING & TELEMETRY
# =============================================================================
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_HEALTH_CHECK=true
HEALTH_CHECK_INTERVAL_SECONDS=30

# =============================================================================
# BACKUP & DISASTER RECOVERY
# =============================================================================
ENABLE_AUTO_BACKUP=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=90
BACKUP_PATH=/backups

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# Backend Workers
WORKERS=4
MAX_REQUESTS_PER_WORKER=1000

# Connection Pools
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Cache Configuration
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

# =============================================================================
# DEVELOPMENT/DEBUG (Disable in production)
# =============================================================================
DEBUG_MODE=false
ENABLE_API_DOCS=false  # Swagger/OpenAPI docs
ALLOW_CORS=false
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# LIBRECHAT SPECIFIC
# =============================================================================
LIBRECHAT_TITLE="Federal AI Assistant"
LIBRECHAT_DESCRIPTION="Secure AI chatbot for federal operations"
ALLOW_REGISTRATION=false  # User registration disabled for federal use
ALLOW_SOCIAL_LOGIN=false
ALLOW_EMAIL_LOGIN=true

# =============================================================================
# COMPLIANCE & GOVERNANCE
# =============================================================================
ENABLE_DATA_RESIDENCY_CHECK=true
APPROVED_DATA_REGIONS=us-gov-west-1,us-gov-east-1
ENABLE_EXPORT_CONTROLS=true
CLASSIFICATION_LEVEL=MODERATE  # FISMA level

# Terms of Service & Privacy
REQUIRE_TOS_ACCEPTANCE=true
TOS_VERSION=1.0
PRIVACY_POLICY_URL=https://agency.gov/privacy

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_FILE_UPLOAD=true
ENABLE_CODE_INTERPRETER=false
ENABLE_WEB_SEARCH=false  # Disable for air-gapped environments
ENABLE_IMAGE_GENERATION=false
ENABLE_CONVERSATION_EXPORT=true
ENABLE_FEEDBACK=true
