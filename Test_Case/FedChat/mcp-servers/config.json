{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/data/documents"
      ],
      "description": "Access and manage files in the documents directory",
      "enabled": true,
      "security": {
        "read_only": false,
        "allowed_paths": ["/data/documents"],
        "blocked_paths": ["/data/documents/.git", "/data/documents/.env"]
      }
    },
    "database": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "${DATABASE_URL}"
      ],
      "description": "Query PostgreSQL database",
      "enabled": true,
      "security": {
        "read_only": true,
        "allowed_schemas": ["public"],
        "blocked_tables": ["users", "sessions", "api_keys"]
      }
    },
    "api-client": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fetch"
      ],
      "description": "Make HTTP requests to approved APIs",
      "enabled": true,
      "security": {
        "allowed_domains": [
          "api.agency.gov",
          "internal-api.agency.gov"
        ],
        "blocked_domains": [
          "*"
        ],
        "require_https": true
      }
    },
    "servicenow": {
      "type": "custom",
      "description": "ServiceNow ITSM integration for incident and change management",
      "enabled": true,
      "config": {
        "instance_url": "${SERVICENOW_INSTANCE_URL}",
        "api_version": "v1",
        "timeout": 30
      },
      "security": {
        "authentication": "basic",
        "username": "${SERVICENOW_USERNAME}",
        "password": "${SERVICENOW_PASSWORD}",
        "require_https": true
      },
      "tools": [
        {
          "name": "create_incident",
          "description": "Create a new incident in ServiceNow",
          "parameters": {
            "short_description": "string (required)",
            "description": "string (optional)",
            "urgency": "1-3 (optional, default: 3)",
            "impact": "1-3 (optional, default: 3)",
            "category": "string (optional)",
            "assignment_group": "string (optional)"
          }
        },
        {
          "name": "get_incident",
          "description": "Retrieve incident details by number",
          "parameters": {
            "incident_number": "string (required)"
          }
        },
        {
          "name": "update_incident",
          "description": "Update an existing incident",
          "parameters": {
            "incident_number": "string (required)",
            "fields": "object (required) - fields to update"
          }
        },
        {
          "name": "search_incidents",
          "description": "Search incidents with filters",
          "parameters": {
            "query": "string (optional)",
            "state": "string (optional)",
            "assigned_to": "string (optional)",
            "limit": "number (optional, default: 10)"
          }
        },
        {
          "name": "create_change_request",
          "description": "Create a new change request",
          "parameters": {
            "short_description": "string (required)",
            "description": "string (optional)",
            "type": "string (optional)",
            "risk": "string (optional)",
            "impact": "1-3 (optional)"
          }
        }
      ]
    },
    "splunk": {
      "type": "custom",
      "description": "Splunk integration for log search and security analytics",
      "enabled": true,
      "config": {
        "host": "${SPLUNK_HOST}",
        "port": "${SPLUNK_PORT}",
        "scheme": "https",
        "api_version": "services",
        "timeout": 60
      },
      "security": {
        "authentication": "token",
        "token": "${SPLUNK_API_TOKEN}",
        "require_https": true
      },
      "tools": [
        {
          "name": "search_logs",
          "description": "Execute a Splunk search query",
          "parameters": {
            "query": "string (required) - SPL query",
            "earliest_time": "string (optional, default: -1h)",
            "latest_time": "string (optional, default: now)",
            "max_results": "number (optional, default: 100)"
          }
        },
        {
          "name": "get_notable_events",
          "description": "Retrieve notable security events",
          "parameters": {
            "time_range": "string (optional, default: -24h)",
            "severity": "string (optional)",
            "status": "string (optional)",
            "limit": "number (optional, default: 50)"
          }
        },
        {
          "name": "create_notable_event",
          "description": "Create a notable event in Splunk ES",
          "parameters": {
            "title": "string (required)",
            "description": "string (required)",
            "severity": "string (required) - low, medium, high, critical",
            "owner": "string (optional)"
          }
        },
        {
          "name": "run_saved_search",
          "description": "Execute a saved Splunk search",
          "parameters": {
            "search_name": "string (required)",
            "earliest_time": "string (optional)",
            "latest_time": "string (optional)"
          }
        },
        {
          "name": "get_search_job_results",
          "description": "Get results from a search job",
          "parameters": {
            "job_id": "string (required)",
            "offset": "number (optional, default: 0)",
            "count": "number (optional, default: 100)"
          }
        }
      ]
    }
  },
  "security": {
    "audit_all_calls": true,
    "require_authentication": true,
    "rate_limit_per_minute": 60,
    "timeout_seconds": 30
  }
}
