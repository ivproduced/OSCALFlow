# Red Hat UBI Hardened Dockerfile - LibreChat Frontend

# Builder stage
FROM registry.access.redhat.com/ubi9/nodejs-20:latest AS builder

ARG AGENCY_NAME="Federal Agency"
ARG AGENCY_PRIMARY_COLOR="#002868"

USER 0
WORKDIR /app

# Install git
RUN dnf install -y git && dnf clean all

# Clone LibreChat
RUN git clone --depth 1 --branch v0.7.0 https://github.com/danny-avila/LibreChat.git . && \
    rm -rf .git

# Install dependencies
COPY package.json* ./
RUN npm ci --legacy-peer-deps

# Copy customization files
COPY ./config/librechat.yaml ./librechat.yaml
COPY ./config/custom.css ./client/public/custom.css
COPY ./assets/* ./client/public/assets/ 2>/dev/null || true

# Build with agency branding
RUN echo "VITE_APP_TITLE=\"${AGENCY_NAME} AI Assistant\"" >> .env && \
    echo "VITE_PRIMARY_COLOR=\"${AGENCY_PRIMARY_COLOR}\"" >> .env && \
    npm run frontend

# Production stage - use minimal variant
FROM registry.access.redhat.com/ubi9/nodejs-20-minimal:latest

USER 0
WORKDIR /app

# Install production dependencies
COPY --from=builder /app/package*.json ./
RUN npm ci --omit=dev --legacy-peer-deps && npm cache clean --force

# Copy built application
COPY --from=builder /app .

# Set proper permissions
RUN chown -R 1001:0 /app && \
    chmod -R g+rwX /app

# Run as non-root
USER 1001

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

CMD ["npm", "start"]
