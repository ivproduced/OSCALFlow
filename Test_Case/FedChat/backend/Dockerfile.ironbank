# Iron Bank Hardened Dockerfile
# Platform One DoD Approved Container Images
# Requires CAC/PKI authentication to registry1.dso.mil

FROM registry1.dso.mil/ironbank/opensource/python/python311:latest

WORKDIR /app

# Iron Bank images use microdnf (minimal DNF)
# Install only essential build dependencies
USER 0
RUN microdnf install -y \
    gcc \
    postgresql-devel \
    git \
    curl \
    && microdnf clean all

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create cache directories with proper permissions
RUN mkdir -p /app/.cache/nist_rag /app/.cache/policy_rag && \
    chown -R 1001:0 /app && \
    chmod -R g+rwX /app

# Iron Bank enforces non-root execution (OpenShift compatible)
USER 1001

# Expose application ports
EXPOSE 8000 9090

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Run with limited workers for security
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
