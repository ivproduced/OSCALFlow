# Distroless Hardened Dockerfile
# Minimal attack surface - no shell, no package manager
# Maximum security for production deployments

# Builder stage with full toolchain
FROM python:3.11-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    git \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies to user directory
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Copy application code
COPY . .

# Production stage - distroless (minimal runtime)
FROM gcr.io/distroless/python3-debian12:latest

WORKDIR /app

# Copy Python packages from builder
COPY --from=builder /root/.local /root/.local

# Copy application code
COPY --from=builder /app .

# Set PATH to include pip-installed packages
ENV PATH=/root/.local/bin:$PATH
ENV PYTHONPATH=/app:$PYTHONPATH

# Distroless runs as non-root by default (UID 65532)
USER nonroot

# Expose application ports
EXPOSE 8000 9090

# Note: HEALTHCHECK not supported in distroless (no curl/shell)
# Use Kubernetes/OpenShift liveness probes instead

# Run application
# Format: ["python_module", "arg1", "arg2", ...]
ENTRYPOINT ["/usr/bin/python3", "-m", "uvicorn"]
CMD ["main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
